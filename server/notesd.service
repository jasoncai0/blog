[Unit]
Description=notesd — 博客批注与阅读进度同步
After=network.target

[Service]
Type=simple
User=notesd
Group=notesd
Environment=NOTES_DB=/var/lib/notesd/notes.db
# 口令放单独的文件（600），别写在这个 unit 里：
#   /etc/notesd.env  ->  NOTES_EDIT_KEY=...
EnvironmentFile=-/etc/notesd.env
ExecStart=/usr/bin/python3 /opt/notesd/notesd.py --host 127.0.0.1 --port 8099 --db /var/lib/notesd/notes.db
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/notesd
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
