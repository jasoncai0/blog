{{- $pages := where site.RegularPages "Section" "posts" -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0"><channel><title>{{ .Site.Title }}</title><link>{{ .Site.BaseURL }}</link><description>{{ .Site.Params.description }}</description><language>zh-CN</language>
{{- range $pages.ByDate.Reverse }}
<item><title>{{ .Title }}</title><link>{{ .Permalink }}</link><guid>{{ .Permalink }}</guid><pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate><description>{{ .Params.summary | default .Summary }}</description>{{ range .Params.tags }}<category>{{ with index hugo.Data.tags . }}{{ .name }}{{ else }}{{ . }}{{ end }}</category>{{ end }}</item>
{{- end }}
</channel></rss>
